{
  "id": "/app",
  "name": "Control — Personal Dashboard",
  "short_name": "Control",
  "description": "Private dashboard for tasks, calendar, thoughts and focus.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f5f2",
  "theme_color": "#f5f5f2",
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/control-icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Capture a thought",
      "short_name": "Thought",
      "description": "Save your original thoughts",
      "url": "/capture?mode=thought",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add a task",
      "short_name": "Task",
      "description": "Write a new Control task",
      "url": "/capture?mode=task",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
