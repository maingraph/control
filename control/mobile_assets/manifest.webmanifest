{
  "id": "/app",
  "name": "Control — Quick Capture",
  "short_name": "Control",
  "description": "Private task and thought inbox for Control.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#10141b",
  "theme_color": "#10141b",
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/control-icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Capture thought",
      "short_name": "Thought",
      "description": "Open the raw thought inbox",
      "url": "/app?mode=thought",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New task",
      "short_name": "Task",
      "description": "Capture a task in Control",
      "url": "/app?mode=task",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
